{
  "name": "dsh-cookie-janitor",
  "version": "0.1.0",
  "private": true,
  "description": "按可配置的天数定期清理 dsh-desktop Network 目录下的 Cookies 与 Cookies-journal，让桌面端登录态按时过期。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "locale"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "license": "MIT",
  "dsh": {
    "id": "dsh-cookie-janitor",
    "name": "登录态定期清理",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}